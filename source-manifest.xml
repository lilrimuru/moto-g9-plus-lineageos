  <project path="device/motorola/sm6150-common"
           name="android_device_motorola_sm6150-common"
           remote="arlbr10"
           revision="f4088668c01cd0bec3a96520ac50823190fdd65a" />

  <project path="kernel/motorola/sm6150"
           name="android_kernel_motorola_sm6150"
           remote="arlbr10"
           revision="a31e2e9a5f76dcce51bdb7946f6b502ae5b423d5" />

  <project path="hardware/motorola"
           name="LineageOS/android_hardware_motorola"
           remote="github"
           revision="ffd5182343fb63227308f0f8b268358e3bd2a3b6" />

  <!-- QTI boot control HAL fork: Motorola hybrid GPT attributes + UFS
       boot-LUN switch (odessa A/B). -->
